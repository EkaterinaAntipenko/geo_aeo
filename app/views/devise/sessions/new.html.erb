<% content_for :title, "Вход - Okula" %>

<div class="auth">
  <%= render "shared/reviews" %>

  <section class="auth-panel">
    <h1>Войти в аккаунт</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@company.ru" %>
      </div>

      <div class="field">
        <%= f.label :password, "Пароль" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="checkbox">
          <%= f.check_box :remember_me %>
          <span>Запомнить меня</span>
        </label>
      <% end %>

      <%= f.submit "Войти", class: "btn btn-primary btn-big" %>
    <% end %>

    <p class="auth-switch">Еще нет аккаунта? <%= link_to "Зарегистрироваться", new_user_registration_path %></p>
  </section>
</div>
