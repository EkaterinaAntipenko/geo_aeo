<h1><%= @audit.kind.upcase %>-аудит <%= @audit.site.domain %></h1>

<p>
  <strong>Сайт:</strong>
  <%= link_to @audit.site.domain, site_path(@audit.site) %>
</p>

<p>
  <strong>Статус:</strong>
  <%= @audit.status %>
</p>

<p>
  <strong>Оценка:</strong>
  <%= @audit.total_score || "-" %>
</p>

<h2>Найденные проблемы</h2>

<% @audit.issues.each do |issue| %>
  <article>
    <h3><%= link_to issue.title, audit_issue_path(@audit, issue) %></h3>

    <p>
      <strong>Категория:</strong> <%= issue.category %>,
      <strong>важность:</strong> <%= issue.severity %>,
      <strong>статус:</strong> <%= issue.status %>
    </p>

    <% if issue.page %>
      <p>
        <strong>Страница:</strong>
        <%= issue.page.title %>
      </p>
    <% end %>
  </article>

  <hr>
<% end %>

<%= link_to "Все аудиты", audits_path %>
