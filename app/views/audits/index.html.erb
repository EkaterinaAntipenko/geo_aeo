<h1>Аудиты</h1>

<% @audits.each do |audit| %>
  <article>
    <h3><%= link_to "#{audit.kind.upcase}-аудит #{audit.site.domain}", audit_path(audit) %></h3>

    <p>
      <strong>Запуск:</strong>
      <%= audit.trigger %>, <%= audit.started_at.strftime("%d.%m.%Y") %>
    </p>

    <p>
      <strong>Статус:</strong>
      <%= audit.status %>
    </p>

    <p>
      <strong>Оценка:</strong>
      <%= audit.total_score || "-" %>
    </p>
  </article>

  <hr>
<% end %>
