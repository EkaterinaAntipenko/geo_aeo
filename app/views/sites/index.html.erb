<h1>Мои сайты</h1>

<% @sites.each do |site| %>
  <article>
    <h3><%= link_to site.domain, site_path(site) %></h3>

    <p>
      <strong>CMS:</strong>
      <%= site.cms %>
    </p>

    <p>
      <strong>Тип:</strong>
      <%= site.site_type %>
    </p>

    <p>
      <strong>GEO:</strong> <%= site.geo_score %>
      <strong>AEO:</strong> <%= site.aeo_score %>
      <strong>SEO:</strong> <%= site.seo_score %>
    </p>
  </article>

  <hr>
<% end %>
