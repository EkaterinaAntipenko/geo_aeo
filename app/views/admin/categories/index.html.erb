<% content_for :title, "Категории - Okula" %>
<% breadcrumbs(["Админка", admin_root_path], ["Категории"]) %>

<%= render "admin/tabs" %>

<section class="panel appear">
  <div class="admin-head">
    <h1 class="card-title">Категории</h1>
    <%= link_to "+ Новая категория", new_admin_category_path, class: "btn btn-primary" %>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>Название</th>
        <th>Советов</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.name %></td>
          <td class="muted"><%= category.articles.count %></td>
          <td class="admin-actions">
            <%= link_to "Изменить", edit_admin_category_path(category), class: "pill" %>
            <%= button_to "Удалить", admin_category_path(category), method: :delete, class: "pill pill-danger",
                  form: { data: { turbo_confirm: "Удалить категорию «#{category.name}»?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
