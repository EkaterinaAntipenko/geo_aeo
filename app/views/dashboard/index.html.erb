<% content_for :title, "Дашборд - Okula" %>
<% breadcrumbs(["Дашборд"]) %>

<div class="dashboard">
  <section class="score-wrap appear">
    <div class="score-card">
      <h2 class="card-title">Баллы оптимизации</h2>
      <p class="score-value"><%= current_site&.score || "-" %></p>
      <p class="score-text"><%= current_site ? current_site.score_text : "Подключите сайт, чтобы увидеть оценку" %></p>
    </div>
    <%= link_to((current_site ? audit_path : new_onboarding_path), class: "score-link", aria: { label: "Подробнее" }) do %>
      <%= image_tag "okula/score-arrow.svg", alt: "" %>
    <% end %>
  </section>

  <section class="panel tips-panel appear">
    <h2 class="card-title">Советы</h2>
    <div class="tips-row" data-controller="scroll-row" data-action="wheel->scroll-row#scroll">
      <% @articles.each do |article| %>
        <%= link_to article_path(article), class: "tip-mini glow-hover" do %>
          <%= image_tag article.image, alt: "", class: "tip-mini-img float-img" %>
          <span><%= article.title %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="panel chart-panel appear">
    <%= turbo_frame_tag "mentions_chart", class: "chart-frame" do %>
    <div class="chart-head">
      <h2 class="card-title">Кол-во упоминаний</h2>
      <div class="chart-controls">
        <%= link_to "Подробнее", statistics_path, class: "pill", data: { turbo_frame: "_top" } %>
        <span class="pill pill-icon"><%= image_tag "okula/chart-type.svg", alt: "Линейный график" %></span>
        <%= form_with url: root_path, method: :get, data: { controller: "autosubmit", turbo_action: "advance" } do %>
          <%= select_tag :period, options_for_select([ [ "Год", "year" ], [ "Полгода", "half" ], [ "Квартал", "quarter" ] ], @period),
                class: "pill pill-select", data: { action: "change->autosubmit#submit" } %>
        <% end %>
      </div>
    </div>

    <% values = @mentions.map(&:last) %>
    <% if values.any? %>
      <% max = chart_max(values) %>
      <div class="chart">
        <div class="chart-axis">
          <% 4.downto(0) do |i| %>
            <span><%= max * i / 4 %></span>
          <% end %>
        </div>
        <svg class="chart-svg" viewBox="0 0 630 190" preserveAspectRatio="none">
          <% 5.times do |i| %>
            <line x1="0" x2="630" y1="<%= 2 + i * 46.5 %>" y2="<%= 2 + i * 46.5 %>" class="chart-grid" />
          <% end %>
          <g transform="translate(2 2)">
            <path d="<%= chart_path(chart_points(values, 626, 186)) %>" class="chart-line" pathLength="1" />
          </g>
        </svg>
        <div class="chart-months">
          <% @mentions.each do |month, count| %>
            <span title="<%= count %>"><%= month_name(month) %></span>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="empty-text">Здесь появится график, когда мы проверим ответы нейросетей по вашему сайту.</p>
    <% end %>
    <% end %>
  </section>

  <section class="panel pages-panel appear">
    <h2 class="card-title">Продвигаемые страницы</h2>
    <% if @queries.any? %>
      <ol class="ranking">
        <% @queries.each_with_index do |query, i| %>
          <li class="<%= 'first' if i.zero? %>">
            <span class="rank"><%= i + 1 %></span>
            <% if query.trend %>
              <%= image_tag "okula/trend-#{query.trend}.svg", alt: query.trend == "up" ? "растёт" : "падает", class: "trend trend-#{query.trend}" %>
            <% end %>
            <span class="rank-title"><%= query.text.upcase_first %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="empty-text">Добавим запросы после первой проверки сайта.</p>
    <% end %>
  </section>
</div>
