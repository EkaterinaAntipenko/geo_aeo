<h1><%= @query.text %></h1>

<p>
  <strong>Сайт:</strong>
  <%= link_to @query.site.domain, site_path(@query.site) %>
</p>

<h2>Позиции в ответах ИИ</h2>

<% @position_snapshots.each do |position_snapshot| %>
  <p>
    <%= position_snapshot.checked_at.strftime("%d.%m.%Y") %>,
    <%= position_snapshot.engine.name %>,
    <%= position_snapshot.competitor ? position_snapshot.competitor.name : "мой сайт" %>:
    <%= position_snapshot.is_mentioned ? "позиция #{position_snapshot.position}" : "не упомянут" %>
  </p>
<% end %>

<%= link_to "Назад к сайту", site_path(@query.site) %>
