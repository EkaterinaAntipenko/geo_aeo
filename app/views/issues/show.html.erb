<h1><%= @issue.title %></h1>

<p>
  <strong>Аудит:</strong>
  <%= link_to "#{@audit.kind.upcase}-аудит #{@audit.site.domain}", audit_path(@audit) %>
</p>

<p>
  <strong>Категория:</strong> <%= @issue.category %>,
  <strong>важность:</strong> <%= @issue.severity %>,
  <strong>статус:</strong> <%= @issue.status %>
</p>

<p><%= @issue.description %></p>

<h2>Что сделать</h2>

<% @issue.recommendations.each do |recommendation| %>
  <h3><%= recommendation.title %></h3>

  <p><%= recommendation.explanation %></p>

  <p>
    <strong>Эффект:</strong> <%= recommendation.expected_impact %>,
    <strong>усилия:</strong> <%= recommendation.effort %>
  </p>

  <% recommendation.code_patches.each do |code_patch| %>
    <p>
      <strong>Готовый код (<%= code_patch.target %>)</strong>
      <%= code_patch.file_path %>
      <%= "- применён" if code_patch.applied %>
    </p>

    <pre><%= code_patch.code %></pre>
  <% end %>

  <% recommendation.tasks.each do |task| %>
    <p>
      <strong>Задача:</strong>
      <%= task.status %>, исполнитель: <%= task.assignee ? task.assignee.name : "не назначен" %>
    </p>
  <% end %>
<% end %>

<%= link_to "Назад к аудиту", audit_path(@audit) %>
