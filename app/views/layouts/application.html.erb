<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Okula" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Okula">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-cache-control" content="no-preview">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Goldman&family=Inter:wght@300;400;500;600&display=swap">

    <%= stylesheet_link_tag "application", "ui", "layout", "dashboard", "pages", "auth", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>

      <div class="shell">
        <%= render "shared/sidebar" %>
        <label for="nav-toggle" class="nav-backdrop"></label>

        <div class="main">
          <%= render "shared/topbar" %>

          <div class="crumbs"><%= yield :breadcrumbs %></div>

          <%= render "shared/flash" %>

          <main class="content">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%= render "shared/flash" %>

      <main class="guest">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
